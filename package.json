{
  "name": "@djarin/next-inspect",
  "version": "0.1.3",
  "description": "Zero-code, pluggable request/console log inspector for Next.js. Captures API calls, server-side fetches and console output with file:line initiators — no per-call code needed.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "next",
    "nextjs",
    "logs",
    "inspector",
    "terminal",
    "debugging",
    "middleware",
    "logger",
    "nextjs logger"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "default": "./dist/plugin/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./inspector-theme.css": "./dist/components/inspector-theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "npm run build && npm run dev --workspace=next-inspect-demo",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/components/inspector-theme.css', 'dist/components/inspector-theme.css')\"",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "workspaces": [
    "example"
  ],
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^30.1.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
